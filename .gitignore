# --- 虚拟环境（venv 自带 .gitignore 也会忽略自身，这里显式声明以防万一）---
.venv/
venv/
env/

# --- Python 字节码 ---
__pycache__/
*.py[cod]
*$py.class

# --- 测试与工具缓存 ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- 打包产物 ---
build/
dist/
*.egg-info/

# --- IDE ---
.idea/
.vscode/

# --- 密钥（绝不入库）---
.env
*.pem
*.key

# --- 系统与日志 ---
.DS_Store
Thumbs.db
*.log
